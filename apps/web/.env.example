# diet-tracker web app environment
#
# The browser app needs nothing here: it is served by the API and calls it on the same
# origin. Only the build that ships inside the iOS and Android shells does, because that
# bundle runs on capacitor://localhost and has to be told where the API is.
#
# Copy this file to apps/web/.env.native (git-ignored) and set the origin, then run
# `pnpm --filter @diet-tracker/web cap:sync`. See docs/NATIVE.md.

# The https origin of the deployed API, no trailing slash.
VITE_API_ORIGIN=https://<your-service>.up.railway.app
