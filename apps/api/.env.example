# diet-tracker API environment
#
# Copy this file to apps/api/.env for local development and fill in the values.
# .env is git-ignored; this example is the documented contract and is validated
# by zod at boot, so a missing or malformed value fails fast with its name.
#
# On Railway, set the same variables in the service's Variables tab.
# DATABASE_URL and PORT are injected by Railway automatically.

# --- Runtime ---------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Port the API listens on. Railway injects its own value; keep 3000 locally.
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- Database --------------------------------------------------------------

# Local: the docker compose Postgres from `docker compose up -d db` (host port 5433,
# chosen so it never collides with another project's Postgres on 5432). Use 127.0.0.1,
# not localhost: on Windows, localhost resolves to IPv6 first and Docker's IPv6 port
# mapping can hang instead of connecting.
# Railway: injected by the Postgres plugin, do not set it by hand.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/diet_tracker

# --- Auth ------------------------------------------------------------------

# 32+ random bytes, hex encoded. Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different value on Railway than locally. Rotating it logs everyone out.
SESSION_SECRET=

# Public origin the app is served from, no trailing slash.
# Local: http://localhost:5173 (the Vite dev server proxies /api to :3000).
# Railway: https://<your-service>.up.railway.app, or the custom domain later.
# Used for cookie Secure/SameSite settings and absolute links.
APP_ORIGIN=http://localhost:5173

# --- OpenAI ----------------------------------------------------------------

# Server-side only. Never prefixed with VITE_, never shipped to the browser.
# Create at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model used for food estimation, plan explanations and weekly reviews.
# One strong model for everything (decision D6). Model IDs change over time;
# confirm the current strongest general model when slice 3 starts.
OPENAI_MODEL=gpt-5

# Per-user cap on OpenAI calls per local day. Library re-logs make no call.
AI_DAILY_CALL_CAP=150
