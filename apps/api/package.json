{
  "name": "@diet-tracker/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "node --watch --conditions=development --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/migrate.js && node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=development --import tsx src/migrate.ts",
    "db:seed": "node --conditions=development --import tsx src/db/seed.ts",
    "ai:smoke": "node --conditions=development --import tsx src/scripts/ai-smoke.ts",
    "ai:smoke:plan": "node --conditions=development --import tsx src/scripts/ai-smoke-plan.ts",
    "ai:smoke:week": "node --conditions=development --import tsx src/scripts/ai-smoke-week.ts"
  },
  "dependencies": {
    "@diet-tracker/shared": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^5.0.2"
  }
}
